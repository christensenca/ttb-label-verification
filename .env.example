# Copy to .env and fill in. .env is gitignored.

# API key — works for both OpenRouter and direct OpenAI
OPENAI_API_KEY=

# Base URL — swap between OpenRouter (dev) and direct OpenAI (demo) here.
# OpenRouter:    https://openrouter.ai/api/v1
# Direct OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model. Use the OpenRouter slug while OPENAI_BASE_URL points there;
# switch to a bare OpenAI model name (e.g. gpt-4o) when going direct.
OPENAI_MODEL=openai/gpt-4o
