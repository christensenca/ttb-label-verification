# Copy to .env and fill in. .env is gitignored.

# --- Pipeline (extraction) ---

# OpenRouter API key — https://openrouter.ai/settings/keys
# Read by pipeline/extract.py.
OPENROUTER_API_KEY=

# Model slug. OpenRouter slugs — swap providers by changing the slug.
# Examples: openai/gpt-4o, anthropic/claude-sonnet-4, google/gemini-3.1-pro-preview
OPENROUTER_MODEL=google/gemini-3.1-pro-preview

# Max in-flight vision calls (background-task semaphore in app/services/processor.py).
EXTRACTION_CONCURRENCY=3

# --- Backend (FastAPI) ---

# SQLAlchemy URL. Use psycopg driver scheme.
# Local dev example: postgresql+psycopg://ttb:ttb@localhost:5432/ttb_verify
DATABASE_URL=postgresql+psycopg://ttb:ttb@localhost:5432/ttb_verify

# Where uploaded + fixture images live on disk. Mounted as a volume in prod.
IMAGE_STORAGE_DIR=./.local/images

# Comma-separated origins allowed by CORS middleware.
# Local dev: http://localhost:5173 (Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173
