# Copy to .env and fill in. .env is gitignored.

# OpenRouter API key — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Model. OpenRouter slugs — swap providers by changing the slug.
# Examples: openai/gpt-4o, anthropic/claude-sonnet-4, google/gemini-2.0-pro
OPENROUTER_MODEL=openai/gpt-4o
